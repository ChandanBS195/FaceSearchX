# Blockchain Configuration
# Default Anvil local node RPC URL
RPC_URL=http://127.0.0.1:8545

# Replace with the private key from your Anvil instance or Metamask (for testnet/mainnet)
# Default Anvil account #0 private key:
PRIVATE_KEY=

# Contract address deployed on the network (Leave empty to deploy automatically on first run)
CONTRACT_ADDRESS=

# SerpApi Key for Reverse Image Search
SERPAPI_API_KEY=
